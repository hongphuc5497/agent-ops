.DS_Store

# Python cache from local script execution.
__pycache__/
*.pyc

# Local IDE config and logs
.antigravitycli/
.gemini/

# Agent Ops working directory — runtime state is local-only. We ignore the
# directory's contents, not the directory itself, so the source files below
# can be re-included with `!` patterns (git can't un-ignore a file whose
# parent directory is itself ignored).
.ai/*

# Source files shipped via npm `files` MUST be tracked so CI can publish them.
# They live inside .ai/ to mirror the on-disk layout that agent-ops init
# produces in target repos.
!.ai/protocol.md
!.ai/ROUTING.md
!.ai/routing.example.json
!.ai/schema/
.ai/schema/.*
!.ai/templates/
.ai/templates/.*
!.ai/workflows/
.ai/workflows/.*

# Project content the agent-ops repo itself maintains — task lock and ADRs.
# In target repos these are user data and gitignored by default (the user
# chooses whether to commit). Here we commit them because they're our own.
!.ai/TASK.md
!.ai/DECISIONS.md

# Brainstorm / session scratch artifacts.
.superpowers/
.gstack/
